# Copy to backend/.env and adjust. All values have safe local defaults.
ENV=development
DATABASE_URL=sqlite:///./data/airbnb.db
MEDIA_DIR=media
# Where uploaded photos are stored: "local" (disk) or "s3" (then also set S3_BUCKET, S3_REGION).
STORAGE_BACKEND=local
#S3_BUCKET=
#S3_REGION=ap-south-1
CORS_ORIGINS=["http://localhost:3000"]

# REQUIRED outside development: generate with  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-jwt-secret-never-use-in-production
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=7
COOKIE_SECURE=false
BCRYPT_ROUNDS=12
# Leave false unless a reverse proxy you control (Nginx, a CDN) sits in FRONT of the API and
# overwrites X-Forwarded-For. The Next.js dev proxy does not, so trusting the header there would let
# clients forge their IP and dodge the rate limits below.
TRUST_PROXY_HEADERS=false

# Credential endpoints are limited per client IP. Behind the Next.js dev proxy every visitor shares
# one IP, so this is loosened for local development. Production should use the default (5/minute).
AUTH_RATE_LIMIT=30/minute
LOOKUP_RATE_LIMIT=60/minute

SERVICE_FEE_RATE=0.14
TAX_RATE=0.12
